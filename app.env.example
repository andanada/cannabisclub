# Plantilla de ~/.config/club-gestio/app.env (l'EnvironmentFile del servei). Copia-la, omple els valors i `chmod 600`.
# Mai es versiona el fitxer real (.gitignore ja l'ignora). Les claus només han de viure en UN lloc del servidor i, a més,
# en el paquet de claus de les còpies (docs/COPIES.md): sense CLUB_FIELD_KEY les dades personals són irrecuperables.
# La primera arrencada desa a la BD un «canari» d'aquestes claus: si més endavant s'arrenca amb unes altres, el servei no arrenca.

# ---------- Obligatòries ----------
# URL del rol SENSE privilegis (el crea `python -m app.cli preparar-bd`). L'aplicació NO ha de fer servir la del propietari.
CLUB_APP_DATABASE_URL=postgresql+psycopg://club_app:<contrasenya>@127.0.0.1:5433/club
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLUB_FIELD_KEY=
# Clau d'índex (cerca per document, PIN i carnets) i, si no hi ha CLUB_AUDIT_KEY, de la qual es deriva la de l'auditoria.
# Qualsevol text llarg i aleatori: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLUB_INDEX_KEY=

# ---------- Recomanades ----------
# Clau pròpia de la cadena d'auditoria (si no, es deriva de CLUB_INDEX_KEY). Si la fas servir, va també al paquet de claus.
# CLUB_AUDIT_KEY=
# Punt de tall (seq) a partir del qual cada entrada d'auditoria ha de portar HMAC (només en actualitzar una BD antiga).
# CLUB_AUDIT_HMAC_DES_DE=

# ---------- Accés: club real = només Tailscale (docs/PRODUCCIO.md § 0) ----------
# Entrada amb carnet RFID + PIN només des de la xarxa Tailscale (comprova-ho des d'un mòbil de la tailnet). 0 = sense carnet.
CLUB_CARNET_XARXES=100.64.0.0/10
# CLUB_LOGIN_CARNET=0
# Només darrere d'un nginx de confiança (fa cas de l'última entrada d'X-Forwarded-For). No és el cas amb `tailscale serve`
# fins que no es comprovi quina IP veu l'aplicació.
# CLUB_TRUST_PROXY=1
# HSTS des de l'aplicació: només amb HTTPS ja comprovat i SENSE l'HSTS de nginx (duplicat).
# CLUB_HSTS=1

# ---------- NOMÉS EN UN SERVIDOR DE PROVES (cada arrencada ho escriu al registre com a ATENCIÓ) ----------
# CLUB_TOTP=0            # entrar sense el codi de l'app d'autenticació
# CLUB_TOTP_REPLAY=0     # permet reutilitzar un codi de l'app dins la seva finestra

# ---------- Ajustos (valors per defecte entre parèntesis) ----------
# CLUB_LOGIN_IP_LIMIT=60          # peticions de login per IP i minut
# CLUB_ARGON_CONCURRENCY=4        # verificacions de contrasenya simultànies
# CLUB_MAX_BODY_BYTES=1048576     # mida màxima d'una petició (alinea-ho amb client_max_body_size de nginx)
# CLUB_LOG_LEVEL=INFO
# CLUB_K_ANONIMAT=                # llindar d'agregació dels informes de socis (mínim 5)
# Retenció de dades (RGPD): `actualitzar-bd` les copia a la BD; no s'apliquen sense executar la retenció (docs/RGPD.md)
# CLUB_RETENCIO_MIN_DIES=365       # dies mínims de conservació des de la baixa d'un soci
# CLUB_RETENCIO_FOTOS_DIES=365     # fotos antigues d'un soci amb una de més nova
# CLUB_RETENCIO_INTENTS_DIES=30    # intents de login fallits

# Les ordres d'administració (preparar-bd, actualitzar-bd, crear-admin) NO fan servir aquest fitxer: necessiten
# CLUB_DATABASE_URL amb el rol PROPIETARI, que no ha d'estar mai aquí.
